# Agent Storefront Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-in-production-dev-key

# Razorpay Test Credentials (Leave blank or fill with test keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Policy Defaults
SESSION_SPEND_CEILING=10000
HUMAN_APPROVAL_THRESHOLD=5000
MAX_DISCOUNT_PCT=15
MAX_UPSELLS_PER_SESSION=1
